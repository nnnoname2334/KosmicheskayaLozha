<Window x:Class="KosmicheskayaLozha.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Космическая ложа" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F0FF">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <!-- Заголовок -->
            <TextBlock Text="🌸 Космическая ложа"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#7B2D8B"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- Логин -->
            <TextBlock Text="Логин" Foreground="#555" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginBox"
                     Height="35" Padding="8,5"
                     FontSize="14"
                     BorderBrush="#7B2D8B"
                     Margin="0,0,0,15"/>

            <!-- Пароль -->
            <TextBlock Text="Пароль" Foreground="#555" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox"
                         Height="35" Padding="8,5"
                         FontSize="14"
                         BorderBrush="#7B2D8B"
                         Margin="0,0,0,25"/>

            <!-- Кнопка входа -->
            <Button Content="Войти"
                    Height="40" FontSize="15"
                    Background="#7B2D8B" Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="LoginButton_Click"/>

            <!-- Ошибка -->
            <TextBlock x:Name="ErrorText"
                       Foreground="Red"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"
                       FontSize="13"/>

        </StackPanel>
    </Grid>
</Window>