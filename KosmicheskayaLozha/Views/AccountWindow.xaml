<Window x:Class="KosmicheskayaLozha.Views.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мой аккаунт" Height="600" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F0FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Background="#7B2D8B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="← Назад"
                    Margin="15" Padding="10,5"
                    Background="White" Foreground="#7B2D8B"
                    BorderThickness="0" Cursor="Hand"
                    Click="BackButton_Click"/>

            <TextBlock Grid.Column="1" Text="Мой аккаунт"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <Button Grid.Column="2" Content="Выйти"
                    Margin="15" Padding="10,5"
                    Background="#FF80AB" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="LogoutButton_Click"/>
        </Grid>

        <!-- Инфо о пользователе -->
        <Border Grid.Row="1" Background="White"
                Margin="20,15,20,5" Padding="20"
                BorderBrush="#DDD" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="UserNameText"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#7B2D8B"/>
                <TextBlock x:Name="UserPhoneText"
                           FontSize="14" Foreground="#555"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Вкладки -->
        <TabControl Grid.Row="2" Margin="20,10,20,20"
                    BorderBrush="#7B2D8B">

            <!-- Вкладка записей -->
            <TabItem Header="Мои записи">
                <ListBox x:Name="AppointmentsList"
                         BorderThickness="0"
                         Background="#F5F0FF">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#DDD"
                                    BorderThickness="1"
                                    Margin="5" Padding="15"
                                    Width="600">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ServiceType.Name}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="#7B2D8B"/>
                                        <TextBlock Text="{Binding Master.FullName}"
                                                   Foreground="#555" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding DateTimeFormatted}"
                                                   Foreground="#333" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding PaymentMethod}"
                                                   Foreground="#888" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{Binding StatusColor}"
                                            Padding="10,5"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="White"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- Вкладка заказов -->
            <TabItem Header="Мои заказы">
                <ListBox x:Name="OrdersList"
                         BorderThickness="0"
                         Background="#F5F0FF">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    BorderBrush="#DDD"
                                    BorderThickness="1"
                                    Margin="5" Padding="15"
                                    Width="600">
                                <StackPanel>
                                    <TextBlock Text="{Binding OrderDateFormatted}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="#7B2D8B"/>
                                    <TextBlock Text="{Binding DeliveryDateFormatted}"
                                               Foreground="#555" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding PaymentMethod}"
                                               Foreground="#888" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="#333" FontWeight="Bold"
                                               Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding TotalText}"
                                               Foreground="#7B2D8B" FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

        </TabControl>
    </Grid>
</Window>