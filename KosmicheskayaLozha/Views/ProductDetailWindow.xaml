<Window x:Class="KosmicheskayaLozha.Views.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F0FF" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название -->
        <TextBlock Grid.Row="0" x:Name="NameText"
                   FontSize="22" FontWeight="Bold"
                   Foreground="#7B2D8B"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"/>

        <!-- Информация -->
        <StackPanel Grid.Row="1">

            <Border Background="White" BorderBrush="#DDD"
                    BorderThickness="1" Padding="15"
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TypeText" Foreground="#555"
                                   Margin="0,0,0,8" FontSize="13"/>
                        <TextBlock x:Name="ManufacturerText" Foreground="#555"
                                   Margin="0,0,0,8" FontSize="13"/>
                        <TextBlock x:Name="RatingText" Foreground="#555"
                                   Margin="0,0,0,8" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="OldPriceText" Foreground="Gray"
                                   TextDecorations="Strikethrough"
                                   Margin="0,0,0,5" FontSize="13"/>
                        <TextBlock x:Name="PriceText"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="#7B2D8B"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="DiscountText"
                                   Foreground="Red" FontWeight="Bold"
                                   FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Описание" FontWeight="Bold"
                       FontSize="14" Foreground="#7B2D8B"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="DescriptionText"
                       TextWrapping="Wrap"
                       Foreground="#333" FontSize="13"
                       LineHeight="22"/>
        </StackPanel>

        <!-- Кнопки -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Назад"
                    Height="40" Margin="0,0,10,0"
                    Background="#DDD" Foreground="#333"
                    BorderThickness="0" Cursor="Hand"
                    Click="BackButton_Click"/>

            <Button Grid.Column="1" Content="🛒 В корзину"
                    Height="40" Margin="10,0,0,0"
                    Background="#7B2D8B" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="AddToCartButton_Click"/>
        </Grid>
    </Grid>
</Window>