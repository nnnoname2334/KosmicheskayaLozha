<Window x:Class="KosmicheskayaLozha.Views.MasterAppointmentDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали записи" Height="450" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F0FF" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Детали записи"
                   FontSize="20" FontWeight="Bold"
                   Foreground="#7B2D8B" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="White"
                BorderBrush="#DDD" BorderThickness="1"
                Padding="20">
            <StackPanel>
                <TextBlock x:Name="DateTimeText"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#7B2D8B" Margin="0,0,0,15"/>

                <TextBlock Text="Клиент" FontWeight="Bold"
                           Foreground="#555" Margin="0,0,0,5"/>
                <TextBlock x:Name="ClientNameText"
                           FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="ClientPhoneText"
                           FontSize="14" Foreground="#777"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Услуга" FontWeight="Bold"
                           Foreground="#555" Margin="0,0,0,5"/>
                <TextBlock x:Name="ServiceText"
                           FontSize="14" Margin="0,0,0,5"/>
                <TextBlock x:Name="PriceText"
                           FontSize="14" Foreground="#7B2D8B"
                           FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="Способ оплаты" FontWeight="Bold"
                           Foreground="#555" Margin="0,0,0,5"/>
                <TextBlock x:Name="PaymentText"
                           FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Комментарий" FontWeight="Bold"
                           Foreground="#555" Margin="0,0,0,5"/>
                <TextBlock x:Name="CommentText"
                           FontSize="14" Foreground="#777"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="← Назад"
                    Height="40" Margin="0,0,10,0"
                    Background="#DDD" Foreground="#333"
                    BorderThickness="0" Cursor="Hand"
                    Click="BackButton_Click"/>

            <Button Grid.Column="1" x:Name="CompleteButton"
                    Content="✓ Завершить запись"
                    Height="40" Margin="10,0,0,0"
                    Background="#4CAF50" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="CompleteButton_Click"/>
        </Grid>
    </Grid>
</Window>