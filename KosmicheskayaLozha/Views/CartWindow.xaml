<Window x:Class="KosmicheskayaLozha.Views.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корзина" Height="600" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F0FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Background="#7B2D8B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="← Назад"
                    Margin="15" Padding="10,5"
                    Background="White" Foreground="#7B2D8B"
                    BorderThickness="0" Cursor="Hand"
                    Click="BackButton_Click"/>

            <TextBlock Grid.Column="1" Text="Корзина"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>

        <!-- Список товаров -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="CartPanel"
                       Margin="15" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Итого и кнопка заказа -->
        <Grid Grid.Row="2" Background="White"
              Margin="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="TotalText"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#7B2D8B"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>

            <Button Grid.Column="1" Content="Оформить заказ"
                    Height="45" Margin="15"
                    Padding="20,0"
                    Background="#7B2D8B" Foreground="White"
                    FontSize="15" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"
                    Click="OrderButton_Click"/>
        </Grid>
    </Grid>
</Window>