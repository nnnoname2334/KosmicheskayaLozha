<Window x:Class="KosmicheskayaLozha.Views.BookAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запись на сеанс" Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F0FF" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Запись на сеанс"
                   FontSize="20" FontWeight="Bold"
                   Foreground="#7B2D8B" Margin="0,0,0,20"/>

        <!-- Инфо о записи -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#DDD" BorderThickness="1"
                Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock x:Name="ServiceText" FontSize="14"
                           Foreground="#333" Margin="0,0,0,5"/>
                <TextBlock x:Name="MasterText" FontSize="14"
                           Foreground="#333" Margin="0,0,0,5"/>
                <TextBlock x:Name="DateTimeText" FontSize="14"
                           Foreground="#333" Margin="0,0,0,5"/>
                <TextBlock x:Name="PriceText" FontSize="14"
                           FontWeight="Bold" Foreground="#7B2D8B"/>
            </StackPanel>
        </Border>

        <!-- Способ оплаты -->
        <TextBlock Grid.Row="2" Text="Способ оплаты"
                   FontSize="14" FontWeight="Bold"
                   Foreground="#7B2D8B" Margin="0,0,0,8"/>
        <ComboBox Grid.Row="3" x:Name="PaymentCombo"
                  Height="35" Margin="0,0,0,15">
            <ComboBoxItem Content="Наличные" IsSelected="True"/>
            <ComboBoxItem Content="Карта"/>
            <ComboBoxItem Content="СБП"/>
        </ComboBox>

        <!-- Комментарий -->
        <TextBlock Grid.Row="4" Text="Комментарий (необязательно)"
                   FontSize="14" FontWeight="Bold"
                   Foreground="#7B2D8B" Margin="0,0,0,8"/>
        <TextBox Grid.Row="5" x:Name="CommentBox"
                 Padding="8" TextWrapping="Wrap"
                 AcceptsReturn="True"
                 BorderBrush="#7B2D8B"
                 Margin="0,0,0,20"/>

        <!-- Кнопки -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Назад"
                    Height="40" Margin="0,0,10,0"
                    Background="#DDD" Foreground="#333"
                    BorderThickness="0" Cursor="Hand"
                    Click="BackButton_Click"/>

            <Button Grid.Column="1" Content="Записаться"
                    Height="40" Margin="10,0,0,0"
                    Background="#7B2D8B" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BookButton_Click"/>
        </Grid>
    </Grid>
</Window>