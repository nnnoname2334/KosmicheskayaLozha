<Window x:Class="KosmicheskayaLozha.Views.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товары" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F0FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Background="#7B2D8B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="← Назад"
                    Margin="15" Padding="10,5"
                    Background="White" Foreground="#7B2D8B"
                    BorderThickness="0" Cursor="Hand"
                    Click="BackButton_Click"/>

            <TextBlock Grid.Column="1" Text="Товары"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <Button Grid.Column="2" Content="🛒 Корзина"
                    Margin="15" Padding="10,5"
                    Background="White" Foreground="#7B2D8B"
                    FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"
                    Click="CartButton_Click"/>
        </Grid>

        <!-- Фильтры -->
        <Grid Grid.Row="1" Background="White" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="SearchBox"
                     Margin="15,10" Padding="8,5"
                     FontSize="13"
                     BorderBrush="#7B2D8B"
                     TextChanged="SearchBox_TextChanged">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Resources>
                            <VisualBrush x:Key="hint" TileMode="None" Opacity="0.4" Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock Text="🔍 Поиск по названию" FontSize="13"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Style.Resources>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="{StaticResource hint}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <ComboBox Grid.Column="1" x:Name="TypeFilterCombo"
                      Margin="5,10" Padding="5"
                      SelectionChanged="Filter_Changed"/>

            <ComboBox Grid.Column="2" x:Name="ManufacturerFilterCombo"
                      Margin="5,10" Padding="5"
                      SelectionChanged="Filter_Changed"/>

            <ComboBox Grid.Column="3" x:Name="SortCombo"
                      Margin="5,10,15,10" Padding="5"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="По оценке ↓"/>
                <ComboBoxItem Content="По цене ↑"/>
                <ComboBoxItem Content="По цене ↓"/>
            </ComboBox>
        </Grid>

        <!-- Список товаров -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="ProductsPanel"
                       Margin="15" Orientation="Horizontal"/>
        </ScrollViewer>
    </Grid>
</Window>