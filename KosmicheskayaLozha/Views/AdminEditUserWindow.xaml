<Window x:Class="KosmicheskayaLozha.Views.AdminEditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь" Height="560" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <ScrollViewer>
        <Grid Background="#F5F0FF" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TitleText"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#7B2D8B" Margin="0,0,0,20"/>

            <TextBlock Grid.Row="1" Text="Фамилия" FontWeight="Bold"
                       Foreground="#555" Margin="0,0,0,5"/>
            <TextBox Grid.Row="2" x:Name="LastNameBox" Height="35"
                     Padding="8,5" BorderBrush="#7B2D8B" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="3" Text="Имя" FontWeight="Bold"
                       Foreground="#555" Margin="0,0,0,5"/>
            <TextBox Grid.Row="4" x:Name="FirstNameBox" Height="35"
                     Padding="8,5" BorderBrush="#7B2D8B" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="5" Text="Отчество" FontWeight="Bold"
                       Foreground="#555" Margin="0,0,0,5"/>
            <TextBox Grid.Row="6" x:Name="MiddleNameBox" Height="35"
                     Padding="8,5" BorderBrush="#7B2D8B" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="7" Text="Телефон" FontWeight="Bold"
                       Foreground="#555" Margin="0,0,0,5"/>
            <TextBox Grid.Row="8" x:Name="PhoneBox" Height="35"
                     Padding="8,5" BorderBrush="#7B2D8B" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="9" Text="Логин" FontWeight="Bold"
                       Foreground="#555" Margin="0,0,0,5"/>
            <TextBox Grid.Row="10" x:Name="LoginBox" Height="35"
                     Padding="8,5" BorderBrush="#7B2D8B" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="11" Text="Пароль (оставьте пустым чтобы не менять)"
                       FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
            <PasswordBox Grid.Row="12" x:Name="PasswordBox" Height="35"
                         Padding="8,5" BorderBrush="#7B2D8B" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="13" Text="Роль" FontWeight="Bold"
                       Foreground="#555" Margin="0,0,0,5"/>
            <ComboBox Grid.Row="14" x:Name="RoleCombo" Height="35"
                      BorderBrush="#7B2D8B" Margin="0,0,0,20"/>

            <Grid Grid.Row="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Отмена"
                        Height="40" Margin="0,0,10,0"
                        Background="#DDD" Foreground="#333"
                        BorderThickness="0" Cursor="Hand"
                        Click="CancelButton_Click"/>
                <Button Grid.Column="1" Content="Сохранить"
                        Height="40" Margin="10,0,0,0"
                        Background="#7B2D8B" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="SaveButton_Click"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>