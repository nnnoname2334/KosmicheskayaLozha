<Window x:Class="KosmicheskayaLozha.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Страница администратора" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F0FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Background="#7B2D8B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="🔧 Администратор"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>

            <Button Grid.Column="1" Content="Выйти"
                    Margin="15" Padding="10,5"
                    Background="#FF80AB" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="LogoutButton_Click"/>
        </Grid>

        <!-- Контент -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Кнопки -->
            <StackPanel Grid.Row="0" Orientation="Horizontal"
                        Margin="0,0,0,15">
                <Button Content="+ Добавить пользователя"
                        Padding="15,8" Margin="0,0,10,0"
                        Background="#7B2D8B" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="AddUserButton_Click"/>
            </StackPanel>

            <!-- Список пользователей -->
            <ListBox Grid.Row="1" x:Name="UsersList"
                     BorderBrush="#DDD">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Width="820"
                                BorderBrush="#EEE"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding FullName}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Login}"
                                           Foreground="#555"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Phone}"
                                           Foreground="#555"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Role.RoleName}"
                                           Foreground="#7B2D8B"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4"
                                           Text="{Binding FrozenText}"
                                           Foreground="#888"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="5"
                                        Content="✎"
                                        Padding="8,5"
                                        Background="#FF9800"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Tag="{Binding UserId}"
                                        Click="EditUserButton_Click"/>

                                <Button Grid.Column="6"
                                        Content="{Binding FreezeButtonText}"
                                        Padding="8,5"
                                        Background="#607D8B"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Tag="{Binding UserId}"
                                        Click="FreezeUserButton_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>