<Window x:Class="KosmicheskayaLozha.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Страница менеджера" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F0FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Background="#7B2D8B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="👔 Страница менеджера"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>

            <Button Grid.Column="1" Content="Выйти"
                    Margin="15" Padding="10,5"
                    Background="#FF80AB" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="LogoutButton_Click"/>
        </Grid>

        <!-- Вкладки -->
        <TabControl Grid.Row="1" Margin="15"
                    BorderBrush="#7B2D8B">

            <!-- Записи -->
            <TabItem Header="Записи">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                Margin="0,0,0,10">
                        <Button Content="+ Создать запись"
                                Padding="15,8" Margin="0,0,10,0"
                                Background="#7B2D8B" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="CreateAppointmentButton_Click"/>
                        <Button Content="✎ Перенести"
                                Padding="15,8" Margin="0,0,10,0"
                                Background="#FF9800" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="RescheduleButton_Click"/>
                        <Button Content="✕ Отменить"
                                Padding="15,8"
                                Background="#F44336" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="CancelAppointmentButton_Click"/>
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="AppointmentsList"
                             BorderBrush="#DDD">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Width="900"
                                        BorderBrush="#EEE"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DateTimeFormatted}"
                                                   FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Client.FullName}"
                                                   Foreground="#555"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Master.FullName}"
                                                   Foreground="#555"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding ServiceType.Name}"
                                                   Foreground="#7B2D8B"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Status}"
                                                   Foreground="#333"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Заказы -->
            <TabItem Header="Заказы">
                <Grid Margin="10">
                    <ListBox x:Name="OrdersList" BorderBrush="#DDD">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Width="900"
                                        BorderBrush="#EEE"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding OrderDateFormatted}"
                                                   FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Client.FullName}"
                                                   Foreground="#555"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DeliveryDateFormatted}"
                                                   Foreground="#555"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding PaymentMethod}"
                                                   Foreground="#555"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Status}"
                                                   Foreground="#7B2D8B"
                                                   FontWeight="Bold"/>
                                        <Button Grid.Column="5"
                                                Content="Выдать"
                                                Padding="10,5"
                                                Background="#4CAF50"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Tag="{Binding OrderId}"
                                                Click="CompleteOrderButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Товары -->
            <TabItem Header="Товары">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="+ Добавить товар"
                            Padding="15,8" Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            Background="#7B2D8B" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="AddProductButton_Click"/>

                    <ListBox Grid.Row="1" x:Name="ProductsList"
                             BorderBrush="#DDD">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Width="900"
                                        BorderBrush="#EEE"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PriceText}"
                                                   Foreground="#555"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DiscountText}"
                                                   Foreground="Red"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Manufacturer.Name}"
                                                   Foreground="#555"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding FrozenText}"
                                                   Foreground="#888"/>
                                        <Button Grid.Column="5"
                                                Content="✎"
                                                Padding="8,5"
                                                Background="#FF9800"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Tag="{Binding ProductId}"
                                                Click="EditProductButton_Click"/>
                                        <Button Grid.Column="6"
                                                Content="{Binding FreezeButtonText}"
                                                Padding="8,5"
                                                Background="#607D8B"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Tag="{Binding ProductId}"
                                                Click="FreezeProductButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Производители -->
            <TabItem Header="Производители">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="+ Добавить производителя"
                            Padding="15,8" Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            Background="#7B2D8B" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="AddManufacturerButton_Click"/>

                    <ListBox Grid.Row="1" x:Name="ManufacturersList"
                             BorderBrush="#DDD">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Width="900"
                                        BorderBrush="#EEE"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Country}"
                                                   Foreground="#555"/>
                                        <Button Grid.Column="2"
                                                Content="✎"
                                                Padding="8,5"
                                                Background="#FF9800"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Tag="{Binding ManufacturerId}"
                                                Click="EditManufacturerButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Типы товаров -->
            <TabItem Header="Типы товаров">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="+ Добавить тип товара"
                            Padding="15,8" Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            Background="#7B2D8B" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="AddProductTypeButton_Click"/>

                    <ListBox Grid.Row="1" x:Name="ProductTypesList"
                             BorderBrush="#DDD">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Width="900"
                                        BorderBrush="#EEE"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontWeight="Bold"/>
                                        <Button Grid.Column="1"
                                                Content="✎"
                                                Padding="8,5"
                                                Background="#FF9800"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Tag="{Binding ProductTypeId}"
                                                Click="EditProductTypeButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Типы услуг -->
            <TabItem Header="Типы услуг">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="+ Добавить тип услуги"
                            Padding="15,8" Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            Background="#7B2D8B" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="AddServiceTypeButton_Click"/>

                    <ListBox Grid.Row="1" x:Name="ServiceTypesList"
                             BorderBrush="#DDD">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Width="900"
                                        BorderBrush="#EEE"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PriceText}"
                                                   Foreground="#7B2D8B"/>
                                        <Button Grid.Column="2"
                                                Content="✎"
                                                Padding="8,5"
                                                Background="#FF9800"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Tag="{Binding ServiceTypeId}"
                                                Click="EditServiceTypeButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>