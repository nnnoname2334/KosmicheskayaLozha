<Window x:Class="KosmicheskayaLozha.Views.ManagerCreateAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать запись" Height="560" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Background="#F5F0FF" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Создать запись"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#7B2D8B" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Клиент (поиск по ФИО или телефону)"
                   FontWeight="Bold" Foreground="#555" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" x:Name="ClientSearchBox" Height="35"
                 Padding="8,5" BorderBrush="#7B2D8B" Margin="0,0,0,5"
                 TextChanged="ClientSearchBox_TextChanged"/>
        <ComboBox Grid.Row="3" x:Name="ClientCombo" Height="35"
                  BorderBrush="#7B2D8B" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Text="Мастер" FontWeight="Bold"
                   Foreground="#555" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="5" x:Name="MasterCombo" Height="35"
                  BorderBrush="#7B2D8B" Margin="0,0,0,10"
                  SelectionChanged="MasterCombo_SelectionChanged"/>

        <TextBlock Grid.Row="6" Text="Доступные записи" FontWeight="Bold"
                   Foreground="#555" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="7" x:Name="SlotCombo" Height="35"
                  BorderBrush="#7B2D8B" Margin="0,0,0,20"/>

        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Отмена"
                    Height="40" Margin="0,0,10,0"
                    Background="#DDD" Foreground="#333"
                    BorderThickness="0" Cursor="Hand"
                    Click="CancelButton_Click"/>
            <Button Grid.Column="1" Content="Создать"
                    Height="40" Margin="10,0,0,0"
                    Background="#7B2D8B" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="CreateButton_Click"/>
        </Grid>
    </Grid>
</Window>